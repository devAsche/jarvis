# Template only. Copy to .env.local and fill in. Never paste secrets into a chat or commit .env files.
# Without READ_ONLY settings the app runs in DEMO mode (fixtures only, no network).

# DEMO | READ_ONLY. READ_ONLY is refused unless the two owner-auth values below are set.
JARVIS_MODE=DEMO
JARVIS_TIMEZONE=Asia/Tokyo
JARVIS_ALLOW_EXTERNAL_EFFECTS=false
JARVIS_ALLOW_PAID_AI=false

# Owner login (required for READ_ONLY). Create the hash with: node scripts/hash-password.mjs
JARVIS_OWNER_PASSWORD_HASH=
# 32+ random characters, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JARVIS_SESSION_SECRET=

# Where the durable store (jarvis-store.json) lives. Use a persistent disk in the cloud.
JARVIS_DATA_DIR=.data
# Minutes after the last successful sync before data is shown as STALE.
JARVIS_STALE_AFTER_MINUTES=90

# Shopify read-only (Dev Dashboard app installed on your own store, scope: read_orders).
# See docs/13_SHOPIFY_SETUP.md
SHOPIFY_SHOP=your-store.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# SHOPIFY_API_VERSION=2026-10

# Shipping rule: per-currency estimate in minor units (JPY has no decimals). Leave empty to turn the rule off.
JARVIS_SHIPPING_ESTIMATE_MINOR={"JPY":900}

# Scheduler secret for POST /api/cron/sync (Authorization: Bearer <secret>). 32+ characters.
JARVIS_CRON_SECRET=
